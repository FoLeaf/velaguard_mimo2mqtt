MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_CLIENT_ID=ai-bridge-dev
# MQTT_TLS=false
#   Enable MQTT over TLS (MQTTS). When false, all certificate path variables
#   below are ignored (plaintext dev posture). No insecure skip-verify switch
#   exists; certificate verification is always on when TLS is enabled.
# MQTT_CA_PATH=
#   CA bundle file path. Empty/blank uses the system CA store.
# MQTT_CLIENT_CERT_PATH=
# MQTT_CLIENT_KEY_PATH=
#   Optional mTLS client certificate and private key. Must be configured as a
#   pair; when MQTT_TLS=true, configured paths must be existing files.
REQUEST_TIMEOUT_MS=30000
PROVIDER=stub
STUB_DELAY_MS=0
LOG_LEVEL=INFO

# --- Diagnosis skill / fallback ----------------------------------------------
# SKILLS_DIR=
#   Directory containing skill markdown files. Defaults to the packaged
#   ai_bridge/skills directory when unset.
DIAGNOSIS_SKILL=industrial_fault_diagnosis
FALLBACK_ENABLED=true

# --- MiMo provider (only used when PROVIDER=mimo) ---------------------------
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
# MIMO_API_KEY=
#   The MiMo API key is a SECRET. It is injected ONLY via the deploy-time
#   server environment (server-local .env). It must never be committed to the
#   repo, tests, fixtures, README, or chat. Keep this example value blank.
MIMO_HTTP_TIMEOUT_MS=15000
MIMO_MAX_RETRIES=2
MIMO_RETRY_BACKOFF_MS=500
